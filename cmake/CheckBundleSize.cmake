if(NOT DEFINED BUNDLE OR NOT IS_DIRECTORY "${BUNDLE}")
  message(FATAL_ERROR "BUNDLE must name an existing .app directory")
endif()
if(NOT DEFINED LIMIT OR NOT LIMIT MATCHES "^[0-9]+$")
  message(FATAL_ERROR "LIMIT must be a byte count")
endif()

file(GLOB_RECURSE bundle_files LIST_DIRECTORIES false "${BUNDLE}/*")
set(total 0)
foreach(path IN LISTS bundle_files)
  file(SIZE "${path}" bytes)
  math(EXPR total "${total} + ${bytes}")
endforeach()
math(EXPR remaining "${LIMIT} - ${total}")
if(remaining LESS 0)
  math(EXPR excess "${total} - ${LIMIT}")
  message(FATAL_ERROR "${BUNDLE} is ${total} bytes, exceeding ${LIMIT} by ${excess} bytes")
endif()
message(STATUS "${BUNDLE}: ${total} bytes (${remaining} bytes free)")
